NODE_ENV=production
MANAGER_WS_URL=wss://manager.example.invalid/api/v1/agent
WORKER_ID=worker-windows-01
WORKER_TOKEN=replace-with-a-random-secret-at-least-32-characters
DOCKER_SOCKET_PATH=/var/run/docker.sock
RECONNECT_BASE_DELAY_MS=1000
